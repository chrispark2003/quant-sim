# Copy to .env and fill in real values. NEVER commit .env with real keys.
# This project only ever paper-trades against a simulated ledger -- these keys
# are used exclusively for pulling market data / news, never for order placement.

# --- Market data ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

POLYGON_API_KEY=

BINANCE_API_KEY=
BINANCE_API_SECRET=
# binance.com geoblocks US IPs (HTTP 451). From the US, uncomment these:
# BINANCE_BASE_URL=https://api.binance.us
# BINANCE_WS_URL=wss://stream.binance.us:9443/ws

NEWSAPI_API_KEY=

# --- Storage ---
DUCKDB_PATH=data/quant_sim.duckdb
PARQUET_DIR=data/parquet

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# --- Misc ---
LOG_LEVEL=INFO
